&in1

 restart = .f.
 regrid  = .f.
 refinement=.false.

 tstep_n = 1.0
 nstep_n = 0

 nout = 20

 ! ============================================================
 ! JET-like DIVERTED (lower single-null X-point) geometry.
 ! Fixed boundary; the boundary is shaped with a lower X-point
 ! (xpoint=.t., xampl>0) and the grid carries the open / leg /
 ! private-flux regions of a diverted plasma (n_open, n_leg,
 ! n_private > 0). Shaping (ellip, quad_l) and the X-point block
 ! follow non_regression_tests/testcases/fixedbound_equil_xpoint.
 ! ============================================================

 fbnd(1)   = 2.
 fbnd(2:4) = 0.
 mf        = 0

 ellip  = 1.7
 tria_u = 0.
 tria_l = 0.
 quad_u = -0.
 quad_l = -0.4

 freeboundary = .f.

 xampl  = +0.22
 xsig   = 0.6
 xwidth = 1.5
 xtheta = 4.7
 xleft  = -0.01
 xshift = 0.02
 xpoint = .t.

 R_begin = 2.9
 R_end   = 3.1
 Z_begin = -0.1
 Z_end   = 0.1

 ! --- JET-like: R0 = 3 m, a = 1 m, F0 = 10 -> B0 = F0/R0 ~ 3.33 T
 R_geo = 3.0
 Z_geo = 0.
 F0    = 10.0
 amin  = 1.0

 ! --- diverted grid (closed core + open SOL + legs + private flux)
 n_R      = 0
 n_Z      = 0
 n_radial = 41
 n_pol    = 64

 n_flux   = 20
 n_tht    = 32
 n_open   = 7
 n_leg    = 7
 n_private = 4

 eta   = 0.3d-4
 visco = 1.d-5
 eta_T_dependent = .false.
 eta_coul_log_dep = .false.

 eta_num = 1.d-10
 visco_num = 1.d-10

 D_par  = 1.d-7
 D_perp = 2.d-4

 ZK_par  = 1.d0
 ZK_perp = 1.d-7

 fix_axis_nodes = .false.

 ! --- pure RE current equilibrium: no FF' and (almost) no pressure.
 ! --- NOTE: the amplitude is zero (FF_0=FF_1=0) but the shape widths
 ! --- FF_coef(4) and FF_coef(8) MUST stay finite: the analytic FFprime
 ! --- evaluation divides by them and produces NaN otherwise.
 FF_0 = 0.d0
 FF_1 = 0.d0
 FF_coef(1:3)  = 0.d0
 FF_coef(4)    = 0.03d0
 FF_coef(5)    = 5.0d0
 FF_coef(6)    = 0.d0
 FF_coef(7)    = 10.d0
 FF_coef(8)    = 1.d0

 heatsource     = 0.d0
 particlesource = 0.d0

 T_0 = 1.d-8
 T_1 = 1.d-8
 T_coef(1) = 0.d0
 T_coef(2) = 0.d0
 T_coef(3) = 0.d0
 T_coef(4) = 1.d0
 T_coef(5) = 5.d0

 rho_0 = 1.
 rho_1 = 1.
 rho_coef(1)  =  0.0
 rho_coef(2)  =  0.0
 rho_coef(3)  =  0.0
 rho_coef(4)  =  1.d0
 rho_coef(5)  =  5.d0

 ! --- kinetic RE drift-surface equilibrium ------------------------------
 ! NOTE: X-point support is NOT yet implemented in the solver (the
 ! re_kinetic_equilibrium branch currently aborts on xpoint2). This input
 ! is the target case for the separatrix-labelling work; it will run once
 ! that lands. Mono 10 MeV, beam confined inside the separatrix
 ! (l_beam = 0.9), contour label map, and a shaping-realistic tolerance.
 re_kinetic_equilibrium = .true.
 re_eq_dist_file        = 're_distribution.dat'
 re_eq_dist_format      = 'ekin_xi_w'
 re_eq_q_file           = 'qprofile_target.dat'
 re_eq_match_mode       = 'full_q'
 re_eq_transplant       = 'cumulative'
 re_eq_map_mode         = 'contour'
 re_eq_xi_min           = 0.9
 re_eq_alpha_out        = 0.2
 re_eq_tol_q            = 1.d-2
 re_eq_tol_q_soft       = 1.5d-2
 re_eq_l_beam           = 0.9
 re_eq_l_beam_width     = 0.1
 re_eq_max_it_out       = 50

 iter_precon = 22
 gmres_m = 20
 gmres_4 = 1.d0
 gmres_max_iter = 200
 gmres_tol = 1.d-8

 ! --- RE particle group: initialized from the drift-surface equilibrium --
 restart_particles = .false.

 part_group_configs(1)%id              = 'REs'
 part_group_configs(1)%Z               = -1
 part_group_configs(1)%coupling_scheme = 'rep'
 part_group_configs(1)%type            = 'particle_kinetic_relativistic'
 part_group_configs(1)%n_particles     = 1e4
 part_group_configs(1)%mass            = 0.000548579870184805
 part_group_configs(1)%init_function   = 'equilibrium'
 ! num_re is IGNORED by init_function='equilibrium': the marker weights are
 ! normalized such that the marker current equals the I_RE of the
 ! drift-surface equilibrium (re_equilibrium.dat) exactly.

 tstep_particles  = 5.d-12

 filter_hyper     = 1.d-9
 filter_hyper_n0  = 1.d-9
 filter_par       = 5.d0
 filter_par_n0    = 5.d0

 keep_current_prof = .false.
 time_evol_scheme = 'Gears'
 use_pastix = .f.
 use_strumpack = .t.
 use_mumps_prj = .f.
 use_strumpack_prj = .t.

 linear_run = .t.

/
